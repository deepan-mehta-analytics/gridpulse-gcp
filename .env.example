# ── GridPulse environment template ──────────────────────────────
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# GCP project (cloud demo windows only — leave blank for local-only work)
GCP_PROJECT_ID=<YOUR_PROJECT_ID>          # placeholder, never a real project ID here
GCP_REGION=europe-west2                   # default region per repo CLAUDE.md

# Elexon IRIS (requires free account registration)
ELEXON_IRIS_ACCOUNT_ID=<YOUR_IRIS_ACCOUNT_ID>

# EIA API v2 (free instant key)
EIA_API_KEY=<YOUR_EIA_KEY>

# ENTSO-E Transparency (requires emailed token, ~3 business days)
ENTSOE_API_TOKEN=<YOUR_ENTSOE_TOKEN>

# Local emulator hosts (defaults match docker-compose.yml ports — usually no change needed)
PUBSUB_EMULATOR_HOST=localhost:8085
BIGTABLE_EMULATOR_HOST=localhost:8086
SPANNER_EMULATOR_HOST=localhost:9010
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=gridpulse
MINIO_SECRET_KEY=gridpulse_local
POSTGRES_DSN=postgresql://gridpulse:gridpulse_local@localhost:5432/gridpulse_ops
